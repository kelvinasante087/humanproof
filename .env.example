# Copy to .env.local and fill in. NEVER commit the real .env file.
# Variable names only here — no secret values.

# Privy (login + embedded wallet)
NEXT_PUBLIC_PRIVY_APP_ID=
# Enable Return user data in an identity token in Privy's Authentication > Advanced dashboard.
# Set true ONLY after enabling it. Required to verify wallet ownership/passkey binding server-side.
PRIVY_IDENTITY_TOKENS_ENABLED=false

# World (Selfie Check)
# Active humanity provider. Switch to `self` only when deliberately restoring
# the Self callback; World remains the default demo path for this deployment.
NEXT_PUBLIC_HUMANPROOF_PROVIDER=world
NEXT_PUBLIC_SELF_ENV=mainnet
SELF_SCOPE=humanproof
# Exact public HTTPS callback, shared by the QR and server verifier. Required.
SELF_ENDPOINT=
# Public receipt discovery. Server-only; do not expose query credentials to browsers.
HUMANPROOF_GRAPH_URL=
HUMANPROOF_GRAPH_API_KEY=

NEXT_PUBLIC_WORLD_APP_ID=app_b9bfc014a67b34d3d17d1184f1118007
NEXT_PUBLIC_WORLD_ACTION=verify-human
# staging = browser simulator; sandbox = approved World ID Sandbox app; production = live World App
NEXT_PUBLIC_WORLD_ENV=staging
# Set to approved only after World confirms Selfie Check access for this app.
WORLD_SELFIE_ACCESS=approved
WORLD_RP_ID=rp_830cfa817576dbc4
# Secret — server-only RP signing key from the Developer Portal. Never commit; never NEXT_PUBLIC_.
WORLD_RP_SIGNING_KEY=
WORLD_API_KEY=

# Session signing — HMAC secret so the verification cookie can't be forged (server-only).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUMANPROOF_SESSION_SECRET=

# Seal — native attestation on Base Sepolia (the from-scratch seal).
# RPC defaults to the public Base Sepolia endpoint; the worker key defaults to the deployer key
# below (fund that address on Base Sepolia via a faucet). Server-only; never NEXT_PUBLIC_.
SEAL_RPC_URL=
SEAL_WORKER_PRIVATE_KEY=

# Future seam: an external sealing engine (e.g. adapted Chronos-V) could replace the native seal.
# Unused while sealing natively; kept so lib/attest can be swapped without env churn.
SEALING_API_URL=
SEALING_API_KEY=

# Convex (database)
NEXT_PUBLIC_CONVEX_URL=
# Optional explicit HTTP-actions URL (.convex.site); otherwise derived from the cloud URL above.
CONVEX_HTTP_URL=
# Same server-only random secret (32+ characters) in Next.js AND its Convex deployment.
HUMANPROOF_BACKEND_SECRET=
HUMANPROOF_ALLOWED_APP_IDS=reviews,airdrop

# ENS v2 (Sepolia) — Day 4
# Public: the parent name we issue subnames under, and a Sepolia RPC the browser may read through.
NEXT_PUBLIC_HUMANPROOF_PARENT_NAME=humanproof.eth
NEXT_PUBLIC_SEPOLIA_RPC_URL=
# Server-only secrets — deployer signs contract txs; issuer signs the EIP-712 humanity voucher.
# Never commit; never add a NEXT_PUBLIC_ prefix.
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
HUMANPROOF_ISSUER_PRIVATE_KEY=
# Salt for hashing the World nullifier before it ever leaves the server (never the raw value).
HUMANPROOF_NULLIFIER_SALT=
